# Complete environment reference. Copy to .env (or .env.<environment>.local) and replace only values you need.
# NEVER commit real credentials. Blank values mean the corresponding optional provider is disabled.

# --- Application ---
APP_ROOT=
NODE_ENV=development
# dev | backtest | paper | live. Live requires explicit production activation gates.
TRADING_MODE=dev

# --- MT5 terminal bridge ---
MT5_ACCOUNT_ID=
MT5_SERVER=
# dotenv reads this value literally (no escape processing), so the doubled
# backslashes below are passed straight through as literal characters.
# Windows path resolution tolerates that, but a single backslash or forward
# slashes (C:/Users/<user>/AppData/Roaming/MetaQuotes/Terminal/Common/Files)
# is less confusing and works identically.
MT5_COMMON_DIRECTORY=C:\\Users\\<user>\\AppData\\Roaming\\MetaQuotes\\Terminal\\Common\\Files
MT5_BRIDGE_SECRET=
MT5_BRIDGE_TIMEOUT_MS=10000
MT5_MAX_REQUEST_AGE_MS=30000
# A client-side submitOrder() timeout marks a durable order FAILED
# synchronously, even though the broker can still fill it moments later.
# Reconciliation looks back this far for FAILED live orders to recover any
# that turn out to have a matching broker position. Default: 24h.
RECONCILIATION_FAILED_LOOKBACK_MS=86400000
MT5_SYMBOL=EURUSD
# Supported: M1 | M5 | M15 | H1 | H4 | D1
MT5_TIMEFRAME=M15
MT5_POLL_INTERVAL_MS=15000
MT5_MAGIC_NUMBER=26090601

# --- Research / historical market-data provider ---
# Legacy generic adapter configuration. Prefer the explicit Twelve Data/Binance keys below.
VENDOR_DATA_PROVIDER=mt5
VENDOR_DATA_API_KEY=
VENDOR_DATA_ENDPOINT=
TWELVE_DATA_API_KEY=
BINANCE_API_KEY=

# --- Normalized external evidence adapters ---
DELTA_EVIDENCE_ENDPOINT=
DELTA_API_KEY=
BINANCE_EVIDENCE_ENDPOINT=
# BINANCE_API_KEY is also used by the direct Binance market-data provider.
NEWS_EVIDENCE_ENDPOINT=
NEWS_API_KEY=
ECONOMIC_EVIDENCE_ENDPOINT=

# --- Direct legitimate providers ---
ALPHA_VANTAGE_API_KEY=
# ECONOMIC_CALENDAR_API_KEY (Trading Economics) requires a paid plan for
# real data — its free "guest:guest" tier is sample data only, not usable
# live. Leave it blank and use FINNHUB_API_KEY below instead; it's a free
# real-data economic-calendar source and satisfies the live-mode evidence
# check on its own. Set both if you do have a paid Trading Economics plan —
# evidence-aggregator.ts merges whatever's configured.
ECONOMIC_CALENDAR_API_KEY=
FINNHUB_API_KEY=

# --- Python / model registry ---
# On Windows, blank means "py"; elsewhere blank means "python3".
PYTHON_COMMAND=
# development | staging | production
MODEL_STAGE=production

# --- ML switch ---
# false = deterministic market-analysis signal; true = configured ML mode.
AI_ENABLED=false
# single | ensemble | hybrid
AI_MODE=ensemble
AI_MIN_PROBABILITY=0.60
AI_MAX_UNCERTAINTY=0.45

# Backward-compatible aliases. AI_* values take precedence when both are set.
MODEL_MIN_PROBABILITY=0.60
MODEL_MAX_UNCERTAINTY=0.45

# --- Evidence / model safety ---
EVIDENCE_MAX_AGE_MS=900000
EVIDENCE_MIN_CONFIDENCE=0.20
DECISION_MIN_REGIME_CONFIDENCE=0.30
DECISION_MIN_CONFIDENCE=0.55
DRIFT_Z_THRESHOLD=3

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=ai_trading_bot

# --- Local dashboard / monitoring ---
DASHBOARD_PORT=8787
MONITOR_POLL_INTERVAL_MS=30000
MONITOR_NO_TRADE_STREAK_ALERT=20
MONITOR_ERROR_STREAK_ALERT=3

# --- Risk controls ---
RISK_MAX_PER_TRADE_PCT=0.005
RISK_MAX_OPEN_POSITIONS=3
RISK_MAX_DAILY_LOSS_PCT=0.03
RISK_MAX_DRAWDOWN_PCT=0.15
RISK_MAX_SPREAD_ATR_FRACTION=0.5
QUOTE_MAX_AGE_MS=15000

# --- Autonomous supplementary market-data acquisition ---
# When enabled, configured Twelve Data/Binance sources are polled automatically
# by the live/paper trading loop. MT5 remains authoritative for execution.
AUTO_RESEARCH_MARKET_DATA=true
AUTO_RESEARCH_QUOTE_INTERVAL_MS=60000
AUTO_RESEARCH_HISTORY_INTERVAL_MS=300000
AUTO_RESEARCH_HISTORY_BARS=250
AUTO_RESEARCH_TIMEOUT_MS=10000
# Set true only if configured supplementary market-data sources must be healthy for live entries.
AUTO_RESEARCH_REQUIRED=false
# Cross-check compatible supplementary quotes against MT5 before a new entry.
AUTO_RESEARCH_CROSSCHECK=true
AUTO_RESEARCH_MAX_QUOTE_DEVIATION_PCT=0.005

# Evidence API polling. The trading loop may run every 15s, but these providers
# are cached so external APIs are not hammered on every trading cycle.
NEWS_REFRESH_INTERVAL_MS=60000
ECONOMIC_REFRESH_INTERVAL_MS=300000

# --- Explicit live activation ---
# Both flags are required. The activation token is deliberately long and must never be committed.
LIVE_TRADING_ENABLED=false
LIVE_ACTIVATION_TOKEN=
# Separate explicit acknowledgement required by live startup.
LIVE_ACTIVATION_CONFIRMATION=
LIVE_REQUIRE_EVIDENCE=true
# Create this file to stop new entries immediately; existing protective orders remain untouched.
LIVE_KILL_SWITCH_FILE=
